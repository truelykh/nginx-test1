pipeline {

    agent any

    triggers {
        githubPush()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Validating website files...'

                sh '''
                    test -f index.html
                    test -f index.css
                    test -f index.js
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying website to NGINX...'

                sh '''
                    mkdir -p /opt/homebrew/var/www/test1

                    rm -rf /opt/homebrew/var/www/test1/*

                    cp -R ./* /opt/homebrew/var/www/test1/

                    echo "Website deployed successfully!"
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                echo 'Testing NGINX...'

                sh '''
                    curl -f http://127.0.0.1:8080/
                '''
            }
        }
    }

    post {

        success {
            echo 'NGINX CI/CD Pipeline completed successfully!'
        }

        failure {
            echo 'NGINX CI/CD Pipeline failed!'
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}